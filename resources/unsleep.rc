#include <windows.h>
#pragma code_page(65001)

1 RT_MANIFEST "app.manifest"

// Application icon. Kept on its long-standing id.
128 ICON "app.ico"

// Tray icons, two palettes by taskbar background and a variant per
// configuration combination. The id follows the picture, not the file name:
//   light-*.ico  -> dark strokes, for a LIGHT taskbar
//   dark-*.ico   -> light strokes, for a DARK taskbar
// src/win32.cpp maps the measured background and the selected options onto
// these ids; resources/icons/DESIGN.md documents the table.
130 ICON "light-inactive.ico"
140 ICON "light-active.ico"
150 ICON "light-screen.ico"
151 ICON "light-screen-paused.ico"
152 ICON "light-duration.ico"
153 ICON "light-screen-duration.ico"
154 ICON "light-screen-paused-duration.ico"

144 ICON "dark-inactive.ico"
145 ICON "dark-active.ico"
155 ICON "dark-screen.ico"
156 ICON "dark-screen-paused.ico"
157 ICON "dark-duration.ico"
158 ICON "dark-screen-duration.ico"
159 ICON "dark-screen-paused-duration.ico"

129 MENU
BEGIN
  POPUP "Unsleep"
  BEGIN
    MENUITEM "防休眠", 40001
    MENUITEM "保持屏幕常亮", 40006
    POPUP "持续时间"
    BEGIN
      MENUITEM "不限时", 40010
      MENUITEM "30 分钟", 40011
      MENUITEM "1 小时", 40012
      MENUITEM "2 小时", 40013
    END
    POPUP "电池保护"
    BEGIN
      MENUITEM "10%", 40003
      MENUITEM "20%", 40004
      MENUITEM "30%", 40005
    END
    MENUITEM SEPARATOR
    MENUITEM "退出", 40002
  END
END
